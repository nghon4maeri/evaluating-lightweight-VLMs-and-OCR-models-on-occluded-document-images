nt(f"Resuming from checkpoint: {len(completed):,} samples already completed.")\n    except Exception as e:\n        print("Checkpoint read warning:", e)\n\npending_pairs = [s for s in pairs if s["sample_id"] not in completed]\nprint(f"Pending samples to evaluate: {len(pending_pairs):,} across {NUM_WORKERS} GPU worker(s)")\n\n\ndef evaluate_single_sample(args: tuple[int, dict]) -> dict:\n    idx, sample = args\n    worker_id = idx % NUM_WORKERS\n    stem = sample["sample_id"]\n    row = {\n        "category": sample["category"],\n        "sample_id": stem,\n        "occlusion_type": sample["occlusion_type"],\n        "occlusion_density": sample["occlusion_density"],\n        "batch_id": sample["batch_id"],\n        "model_id": MODEL_ID,\n        "status": "error",\n        "error": "",\n        "prediction": "",\n        "ground_truth": "",\n        "latency_sec": np.nan,\n        "generated_tokens": 0,\n        "possibly_truncated": False,\n        "cer": np.nan,\n        "wer": np.nan,\n        "token_precision": np.nan,\n        "token_recall": np.nan,\n        "token_f1": np.nan,\n        "gt_words": 0,\n        "pred_words": 0,\n    }\n    try:\n        prediction, elapsed_sec, n_tokens, truncated = predict_page(sample["image_path"], worker_id=worker_id)\n        ground_truth = " ".join(read_gt_tokens(sample["gt_path"]))\n        metrics = compute_metrics(ground_truth, prediction)\n        row.update({\n            "status": "ok",\n            "prediction": prediction,\n            "ground_truth": ground_truth,\n            "latency_sec": elapsed_sec,\n            "generated_tokens": n_tokens,\n            "possibly_truncated": truncated,\n            **metrics,\n        })\n    except Exception as exc:\n        row["error"] = repr(exc)\n        print(f"[ERROR] {stem} (worker {worker_id}): {exc!r}")\n    return row\n\n\nwrite_header = not RESULTS_CSV.exists() or RESULTS_CSV.stat().st_size == 0\nwith open(RESULTS_CSV, "a", newline="", encoding="utf-8") as csv_file:\n    writer = csv.DictWriter(csv_file, fieldnames=FIELDNAMES)\n    if write_header:\n        writer.writeheader()\n        csv_file.flush()\n\n    # Process in chunks of 16 so we can check the 11.2h time guard and flush checkpoints cleanly\n    CHUNK_SIZE = 16\n    pbar = tqdm(total=len(pending_pairs), desc=f"Evaluating {MODEL_SLUG} ({NUM_WORKERS}x GPU)")\n    with concurrent.futures.ThreadPoolExecutor(max_workers=NUM_WORKERS) as pool:\n        for start_idx in range(0, len(pending_pairs), CHUNK_SIZE):\n            if (time.perf_counter() - NOTEBOOK_START_TIME) >= MAX_RUNTIME_SECONDS:\n                print(f"[TIME_GUARD] Reached {MAX_RUNTIME_SECONDS/3600:.1f}h session budget. Stopping loop cleanly to save summary & zip.")\n                break\n\n            chunk = [\n                (start_idx + offset, sample)\n                for offset, sample in enumerate(pending_pairs[start_idx : start_idx + CHUNK_SIZE])\n            ]\n            for row in pool.map(evaluate_single_sample, chunk):\n                writer.writerow(row)\n                pbar.update(1)\n            csv_file.flush()\n\n            if ((start_idx // CHUNK_SIZE) + 1) % 10 == 0 and torch.cuda.is_available():\n                torch.cuda.empty_cache()\n    pbar.close()\n\nresults = pd.read_csv(RESULTS_CSV)\nprint(f"Completed: {(results[\'status\'] == \'ok\').sum():,} / {len(results):,} OK")\nresults[["category", "occlusion_type", "occlusion_density", "cer", "wer", "token_f1", "latency_sec", "status"]].head(10)'}, {'cell_type': 'markdown', 'id': '039d2da4', 'metadata': {}, 'source': '## 7. Macro-Aggregation (Overall, Category, Occlusion Type & Density)'}, {'cell_type': 'code', 'execution_count': 7, 'id': '59125c29', 'metadata': {'execution': {'iopub.execute_input': '2026-11-22T01:13:32.391453Z', 'iopub.status.busy': '2026-11-22T01:13:32.391082Z', 'iopub.status.idle': '2026-11-22T01:13:32.501953Z', 'shell.execute_reply': '2026-11-22T01:13:32.501447Z'}, 'trusted': False}, 'outputs': [{'name': 'std