{'cells': [{'cell_type': 'markdown', 'id': '3c38d540', 'metadata': {}, 'source': '# OPRB Benchmark — 05. EasyOCR (2x T4 Data-Parallel / A100)\n\nZero-shot evaluation of `EasyOCR` (CRAFT + CRNN) with reading-order line clustering across 2x T4 or A100 GPU on the OPRB test set.'}, {'cell_type': 'markdown', 'id': '87818cbe', 'metadata': {}, 'source': '## 1. Install Dependencies'}, {'cell_type': 'code', 'execution_count': 1, 'id': '15fd8c80', 'metadata': {'execution': {'iopub.execute_input': '2026-11-21T18:50:49.137690Z', 'iopub.status.busy': '2026-11-21T18:50:49.137010Z', 'iopub.status.idle': '2026-11-21T18:50:52.658235Z', 'shell.execute_reply': '2026-11-21T18:50:52.657636Z'}, 'trusted': False}, 'outputs': [], 'source': '%pip install -q "easyocr>=1.7" "jiwer>=3.0" "huggingface_hub>=0.20"'}, {'cell_type': 'markdown', 'id': 'dab68204', 'metadata': {}, 'source': '## 2. Configuration & Paths (Multi-GPU 2x T4 Enabled)'}, {'cell_type': 'code', 'execution_count': 2, 'id': '485e428a', 'metadata': {'execution': {'iopub.execute_input': '2026-11-21T18:50:52.663310Z', 'iopub.status.busy': '2026-11-21T18:50:52.663081Z', 'iopub.status.idle': '2026-11-21T18:50:54.510914Z', 'shell.execute_reply': '2026-11-21T18:50:54.510322Z'}, 'trusted': False}, 'outputs': [{'name': 'stdout', 'output_type': 'stream', 'text': 'PyTorch: 2.14.1+cu130 | CUDA available: True | GPU count: 1\n  cuda:0 -> NVIDIA L4 (22.0 GiB)\nDATA_ROOT: /content/oprb_dataset\nOUTPUT_DIR: /content/easyocr_results\n'}], 'source': 'import concurrent.futures\nimport csv\nimport json\nimport os\nimport random\nimport re\nimport shutil\nimport threading\nimport time\nimport unicodedata\nfrom collections import Counter\nfrom pathlib import Path\n\nimport numpy as np\nimport pandas as pd\nimport torch\nfrom PIL import Image\nfrom jiwer import cer, wer\nfrom tqdm.auto import tqdm\n\nNOTEBOOK_START_TIME = time.perf_counter()\nMAX_RUNTIME_SECONDS = int(11.2 * 3600)  # Graceful guard before Kaggle\'s 12h (43,200s) hard timeout\n\nNUM_GPUS = torch.cuda.device_count() if torch.cuda.is_available() else 0\nDEVICES = [f"cuda:{i}" for i in range(NUM_GPUS)] if NUM_GPUS > 0 else ["cpu"]\nprint(f"PyTorch: {torch.__version__} | CUDA available: {torch.cuda.is_available()} | GPU count: {NUM_GPUS}")\nfor i in range(NUM_GPUS):\n    props = torch.cuda.get_device_properties(i)\n    print(f"  cuda:{i} -> {props.name} ({props.total_memory / 2**30:.1f} GiB)")\n\nMODEL_ID = "EasyOCR-en"\nMODEL_SLUG = "easyocr"\n\nCANDIDATE_ROOTS = [\n    Path("/content/oprb_dataset"),\n    Path("/content/oprb-test-data"),\n    Path("/kaggle/input/oprb-test-data/oprb_dataset"),\n    Path("/kaggle/input/oprb-test-data"),\n    Path("./oprb_dataset"),\n]\nDATA_ROOT = next((p for p in CANDIDATE_ROOTS if (p / "text" / "img").exists()), None)\n\n# Auto-setup on Google Colab if oprb_dataset is not yet extracted\nif DATA_ROOT is None and Path("/content").exists():\n    print("[COLAB AUTO-SETUP] Downloading OPRB test split directly from Hugging Face...")\n    import shutil, tarfile\n    from huggingface_hub import hf_hub_download\n    DATA_ROOT = Path("/content/oprb_dataset")\n    for cat in ["text", "nontext"]:\n        for kind, suffix in [("img", ".jpg"), ("gt", ".txt")]:\n            dest = DATA_ROOT / cat / kind\n            dest.mkdir(parents=True, exist_ok=True)\n            if len(list(dest.glob(f"*{suffix}"))) < (6000 if cat == "text" else 3000):\n                tar_p = hf_hub_download(repo_id="kpurkayastha/OPRB", repo_type="dataset", filename=f"test/{cat}/{kind}.tar.gz")\n                with tarfile.open(tar_p, "r:gz") as arc:\n                    for m in arc:\n                        if m.isfile() and m.name.lower().endswith(suffix) and "img_gt" not in m.name and "annots" not in m.name:\n                            fn = Path(m.name).name\n                            target = dest / fn\n                            if not target.exists():\n                                f = arc.extractfile(m)\n                                if f:\n                                    with target.open("wb") as out_f:\n                                        shutil.copyfileobj(f, out_f)\n\nif DATA_ROOT is None:\n    DATA_ROOT = CANDIDATE_ROOTS[0]\n\nOUTPUT_DIR = Path(f"/content/{MODEL_SLUG}_results") if Path("/content").exists() else Path(f"/kaggle/working/{MODEL_SLUG}_results")\nOUTPUT_DIR.mkdir(parents=True, exist_ok=True)\n\nCATEGORIES = ["text", "nontext"]\nMAX_SAMPLES_PER_CATEGORY = None  # None = evaluate all 9,000 test pages\nRANDOM_SEED = 42\nNORMALIZE_CASE = True\n\nprint("DATA_ROOT:", DATA_ROOT)\nprint("OUTPUT_DIR:", OUTPUT_DIR)'}, {'cell_type': 'markdown', 'id': 'b6a96783', 'metadata': {}, 'source': '## 3. Metadata Parsing & Stratified Test Set Pairing'}, {'cell_type': 'code', 'execution_count': 3, 'id': '7c108b2d', 'metadata': {'execution': {'iopub.execute_input': '2026-11-21T18:50:54.515678Z', 'iopub.status.busy': '2026-11-21T18:50:54.515020Z', 'iopub.status.idle': '2026-11-21T18:50:54.826056Z', 'shell.execute_reply': '2026-11-21T18:50:54.825537Z'}, 'trusted': False}, 'outputs': [{'name': 'stdout', 'output_type': 'stream', 'text': 'text: images=6,000, gt=6,000, paired=6,000\nnontext: images=3,000, gt=3,000, paired=3,000\nTotal samples queued for evaluation: 9,000\n'}, {'data': {'text/html': '\n  <div id="df-b6d3e570-5207-4ddb-9f60-133eba87c787" class="colab-df-container">\n    <div>\n<style scoped>\n    .dataframe tbody tr th:only-of-type {\n        vertical-align: middle;\n    }\n\n    .dataframe tbody tr th {\n        vertical-align: top;\n    }\n\n    .dataframe thead th {\n        text-align: right;\n    }\n</style>\n<table border="1" class="dataframe">\n  <thead>\n    <tr style="text-align: right;">\n      <th></th>\n      <th>category</th>\n      <th>occlusion_type</th>\n      <th>occlusion_density</th>\n      <th>batch_id</th>\n      <th>sample_id</th>\n    </tr>\n  </thead>\n  <tbody>\n    <tr>\n      <th>0</th>\n      <td>nontext</td>\n      <td>White_Burnt</td>\n      <td>2p0pct</td>\n      <td>103.tar_1408.3464.gz_slowbondarxivrevised_52_ori</td>\n      <td>White_Burnt__2p0pct__103.tar_1408.3464.gz_slow...</td>\n    </tr>\n    <tr>\n      <th>1</th>\n      <td>text</td>\n      <td>White_Whitener</td>\n      <td>0p5pct</td>\n      <td>103.tar_1606.00648.gz_cosine_space_12_ori</td>\n      <td>White_Whitener__0p5pct__103.tar_1606.00648.gz_...</td>\n    </tr>\n    <tr>\n      <th>2</th>\n      <td>nontext</td>\n      <td>White_Whitener</td>\n      <td>0p5pct</td>\n      <td>103.tar_1705.05613.gz_root_2_ori</td>\n      <td>White_Whitener__0p5pct__103.tar_1705.05613.gz_...</td>\n    </tr>\n    <tr>\n      <th>3</th>\n      <td>nontext</td>\n      <td>White_Burnt</td>\n      <td>1p0pct</td>\n      <td>102.tar_1507.00202.gz_ABMWfinal_6_ori</td>\n      <td>White_Burnt__1p0pct__102.tar_1507.00202.gz_ABM...</td>\n    </tr>\n    <tr>\n      <th>4</th>\n      <td>nontext</td>\n      <td>Through_Dust</td>\n      <td>0p5pct</td>\n      <td>106.tar_1507.02356.gz_iNSGPcad_15a_1_ori</td>\n      <td>Through_Dust__0p5pct__106.tar_1507.02356.gz_iN...</td>\n    </tr>\n  </tbody>\n</table>\n</div>\n    <div class="colab-df-buttons">\n      \n  <div class="colab-df-container">\n    <button class="colab-df-convert" onclick="convertToInteractive(\'df-b6d3e570-5207-4ddb-9f60-133eba87c787\')"\n            title="Convert this dataframe to an interactive table."\n            style="display:none;">\n      \n  <svg xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960">\n    <path d="M120-120v-720h720v720H120Zm60-500h600v-160H180v160Zm220 220h160v-160H400v160Zm0 220h160v-160H400v160ZM180-400h160v-160H180v160Zm440 0h160v-160H620v160ZM180-180h160v-160H180v160Zm440 0h160v-160H620v160Z"/>\n  </svg>\n    </button>\n    \n  <style>\n    .colab-df-container {\n      display:flex;\n      gap: 12px;\n    }\n\n    .colab-df-convert {\n      background-color: #E8F0FE;\n      border: none;\n      border-radius: 50%;\n      cursor: pointer;\n      display: none;\n      fill: #1967D2;\n      height: 32px;\n      padding: 0 0 0 0;\n      width: 32px;\n    }\n\n    .colab-df-convert:hover {\n      background-color: #E2EBFA;\n      box-shadow: 0px 1px 2px rgba(60, 64, 67, 0.3), 0px 1px 3px 1px rgba(60, 64, 67, 0.15);\n      fill: #174EA6;\n    }\n\n    .colab-df-buttons div {\n      margin-bottom: 4px;\n    }\n\n    [theme=dark] .colab-df-convert {\n      background-color: #3B4455;\n      fill: #D2E3FC;\n    }\n\n    [theme=dark] .colab-df-convert:hover {\n      background-color: #434B5C;\n      box-shadow: 0px 1px 3px 1px rgba(0, 0, 0, 0.15);\n      filter: drop-shadow(0px 1px 2px rgba(0, 0, 0, 0.3));\n      fill: #FFFFFF;\n    }\n  </style>\n\n    <script>\n      const buttonEl =\n        document.querySelector(\'#df-b6d3e570-5207-4ddb-9f60-133eba87c787 button.colab-df-convert\');\n      buttonEl.style.display =\n        google.colab.kernel.accessAllowed ? \'block\' : \'none\';\n\n      async function convertToInteractive(key) {\n        const element = document.querySelector(\'#df-b6d3e570-5207-4ddb-9f60-133eba87c787\');\n        const dataTable =\n          await google.colab.kernel.invokeFunction(\'convertToInteractive\',\n                                                    [key], {});\n        if (!dataTable) return;\n\n        const docLinkHtml = \'Like what you see? Visit the \' +\n          \'<a target="_blank" href=https://colab.research.google.com/notebooks/data_table.ipynb>data table notebook</a>\'\n          + \' to learn more about interactive tables.\';\n        element.innerHTML = \'\';\n        dataTable[\'output_type\'] = \'display_data\';\n        await google.colab.output.renderOutput(dataTable, element);\n        const docLink = document.createElement(\'div\');\n        docLink.innerHTML = docLinkHtml;\n        element.appendChild(docLink);\n      }\n    </script>\n  </div>\n  \n    </div>\n  </div>\n  ', 'text/plain': '  category  occlusion_type occlusion_density  \\\n0  nontext     White_Burnt            2p0pct   \n1     text  White_Whitener            0p5pct   \n2  nontext  White_Whitener            0p5pct   \n3  nontext     White_Burnt            1p0pct   \n4  nontext    Through_Dust            0p5pct   \n\n                                           batch_id  \\\n0  103.tar_1408.3464.gz_slowbondarxivrevised_52_ori   \n1         103.tar_1606.00648.gz_cosine_space_12_ori   \n2                  103.tar_1705.05613.gz_root_2_ori   \n3             102.tar_1507.00202.gz_ABMWfinal_6_ori   \n4          106.tar_1507.02356.gz_iNSGPcad_15a_1_ori   \n\n                                           sample_id  \n0  White_Burnt__2p0pct__103.tar_1408.3464.gz_slow...  \n1  White_Whitener__0p5pct__103.tar_1606.00648.gz_...  \n2  White_Whitener__0p5pct__103.tar_1705.05613.gz_...  \n3  White_Burnt__1p0pct__102.tar_1507.00202.gz_ABM...  \n4  Through_Dust__0p5pct__106.tar_1507.02356.gz_iN...  '}, 'execution_count': 3, 'metadata': {}, 'output_type': 'execute_result'}], 'source': 'def parse_occlusion_metadata(stem: str) -> dict:\n    """\n    Parse OPRB filename convention: OcclusionType__density__batchID...\n    Returns occlusion_type, occlusion_density, and batch_id.\n    """\n    parts = stem.split("__", 2)\n    return {\n        "occlusion_type": parts[0] if len(parts) > 0 and parts[0] else "unknown",\n        "occlusion_density": parts[1] if len(parts) > 1 and parts[1] else "unknown",\n        "batch_id": parts[2] if len(parts) > 2 and parts[2] else "unknown",\n    }\n\n\ndef collect_test_pairs(categories: list[str]) -> list[dict]:\n    pairs = []\n    for category in categories:\n        image_dir = DATA_ROOT / category / "img"\n        gt_dir = DATA_ROOT / category / "gt"\n        images = {p.stem: p for p in image_dir.glob("*.jpg")}\n        gts = {p.stem: p for p in gt_dir.glob("*.txt")}\n        common = sorted(images.keys() & gts.keys())\n        print(f"{category}: images={len(images):,}, gt={len(gts):,}, paired={len(common):,}")\n        if not common:\n            raise RuntimeError(f"No paired files found for category \'{category}\' under {DATA_ROOT}")\n        if MAX_SAMPLES_PER_CATEGORY is not None:\n            rng = random.Random(RANDOM_SEED)\n            common = sorted(rng.sample(common, min(MAX_SAMPLES_PER_CATEGORY, len(common))))\n        for stem in common:\n            pairs.append({\n                "category": category,\n                "sample_id": stem,\n                "image_path": str(images[stem]),\n                "gt_path": str(gts[stem]),\n                **parse_occlusion_metadata(stem),\n            })\n    # Deterministic shuffle so text/nontext and all occlusion types/densities are interleaved evenly\n    random.Random(RANDOM_SEED).shuffle(pairs)\n    return pairs\n\n\npairs = collect_test_pairs(CATEGORIES)\nprint(f"Total samples queued for evaluation: {len(pairs):,}")\npd.DataFrame(pairs)[["category", "occlusion_type", "occlusion_density", "batch_id", "sample_id"]].head(5)'}, {'cell_type': 'markdown', 'id': '3f4718f8', 'metadata': {}, 'source': '## 4. Ground-Truth Reader, Text Normalization & Metrics'}, {'cell_type': 'code', 'execution_count': 4, 'id': 'bfb0d938', 'metadata': {'execution': {'iopub.execute_input': '2026-11-21T18:50:54.830696Z', 'iopub.status.busy': '2026-11-21T18:50:54.830464Z', 'iopub.status.idle': '2026-11-21T18:50:54.840275Z', 'shell.execute_reply': '2026-11-21T18:50:54.839759Z'}, 'trusted': False}, 'outputs': [{'name': 'stdout', 'output_type': 'stream', 'text': "Metric sanity check passed: {'cer': 0.36363636363636365, 'wer': 0.3333333333333333, 'token_precision': 1.0, 'token_recall': 0.6666666666666666, 'token_f1': 0.8, 'gt_words': 3, 'pred_words': 2}\n"}], 'source': 'def read_gt_tokens(gt_path: str) -> list[str]:\n    """Read tab-separated OPRB GT file and extract column 0 (token) in row order."""\n    tokens = []\n    with open(gt_path, "r", encoding="utf-8-sig", errors="replace") as f:\n        for line in f:\n            fields = line.rstrip("\\r\\n").split("\\t")\n            if fields and fields[0].strip():\n                tokens.append(fields[0].strip())\n    return tokens\n\n\ndef clean_text(text: str) -> str:\n    """Apply Unicode NFKC normalization, whitespace collapsing, and casefolding."""\n    text = unicodedata.normalize("NFKC", text or "")\n    text = re.sub(r"\\s+", " ", text).strip()\n    return text.casefold() if NORMALIZE_CASE else text\n\n\ndef bag_of_words_prf(reference: str, prediction: str) -> tuple[float, float, float]:\n    """Order-invariant bag-of-words token Precision, Recall, and F1-score."""\n    ref = Counter(reference.split())\n    hyp = Counter(prediction.split())\n    matched = sum((ref & hyp).values())\n    ref_n, hyp_n = sum(ref.values()), sum(hyp.values())\n    precision = matched / hyp_n if hyp_n else (1.0 if ref_n == 0 else 0.0)\n    recall = matched / ref_n if ref_n else (1.0 if hyp_n == 0 else 0.0)\n    f1 = (2 * precision * recall / (precision + recall)) if (precision + recall) else 0.0\n    return float(precision), float(recall), float(f1)\n\n\ndef compute_metrics(ground_truth: str, prediction: str) -> dict:\n    ref = clean_text(ground_truth)\n    hyp = clean_text(prediction)\n    if not ref:\n        raise ValueError("Empty ground-truth transcript; cannot compute CER/WER.")\n    p, r, f1 = bag_of_words_prf(ref, hyp)\n    return {\n        "cer": float(cer(ref, hyp)),\n        "wer": float(wer(ref, hyp)),\n        "token_precision": p,\n        "token_recall": r,\n        "token_f1": f1,\n        "gt_words": len(ref.split()),\n        "pred_words": len(hyp.split()),\n    }\n\n\n_toy = compute_metrics("The cat sat", "The cat")\nassert abs(_toy["wer"] - 1 / 3) < 1e-6, _toy\nprint("Metric sanity check passed:", _toy)'}, {'cell_type': 'markdown', 'id': 'cc8fd7bf', 'metadata': {}, 'source': '## 5. Multi-GPU Model Initialization & Warm-Up'}, {'cell_type': 'code', 'execution_count': 5, 'id': 'a14594e9', 'metadata': {'execution': {'iopub.execute_input': '2026-11-21T18:50:54.844584Z', 'iopub.status.busy': '2026-11-21T18:50:54.844371Z', 'iopub.status.idle': '2026-11-21T18:51:00.987214Z', 'shell.execute_reply': '2026-11-21T18:51:00.986636Z'}, 'trusted': False}, 'outputs': [{'name': 'stdout', 'output_type': 'stream', 'text': "[LOADED] EasyOCR across 1 GPU worker(s): ['cuda:0']\n"}, {'name': 'stdout', 'output_type': 'stream', 'text': 'Warm-up worker 0 (cuda:0) done in 1.84s | sample: I" Figure 16: Lenma 1.2; the dotted curve cannot be part of F4"V . Paof. Let denoto the event 4= F(E) 2 2 k*73 Observe t\n'}], 'source': 'def sort_reading_order(detections: list[tuple], y_tolerance: int = 12) -> str:\n    """\n    Cluster OCR bounding boxes into horizontal lines using y_tolerance,\n    sort lines top-to-bottom and tokens left-to-right, then join into text.\n    Each element in `detections` is (bbox_points, text, confidence).\n    """\n    if not detections:\n        return ""\n\n    items = []\n    for bbox, text, conf in detections:\n        txt = (text or "").strip()\n        if not txt:\n            continue\n        xs = [pt[0] for pt in bbox]\n        ys = [pt[1] for pt in bbox]\n        x_min = float(min(xs))\n        y_center = float(sum(ys) / len(ys))\n        items.append((y_center, x_min, txt))\n\n    if not items:\n        return ""\n\n    items.sort(key=lambda x: x[0])\n    lines: list[list[tuple[float, float, str]]] = []\n    current_line = [items[0]]\n    current_y = items[0][0]\n\n    for item in items[1:]:\n        if abs(item[0] - current_y) <= y_tolerance:\n            current_line.append(item)\n            current_y = sum(x[0] for x in current_line) / len(current_line)\n        else:\n            lines.append(current_line)\n            current_line = [item]\n            current_y = item[0]\n    lines.append(current_line)\n\n    ordered_tokens = []\n    for line in lines:\n        line.sort(key=lambda x: x[1])\n        ordered_tokens.extend(tok for _, _, tok in line)\n\n    return " ".join(ordered_tokens)\n\nimport easyocr\n\nREADERS = [easyocr.Reader(["en"], gpu=dev) for dev in DEVICES]\nLOCKS = [threading.Lock() for _ in DEVICES]\nNUM_WORKERS = len(READERS)\nprint(f"[LOADED] EasyOCR across {NUM_WORKERS} GPU worker(s): {DEVICES}")\n\ndef predict_page(image_path: str, worker_id: int = 0) -> tuple[str, float, int, bool]:\n    device = DEVICES[worker_id]\n    reader = READERS[worker_id]\n    with LOCKS[worker_id]:\n        start = time.perf_counter()\n        detections = reader.readtext(str(image_path), detail=1, paragraph=False)\n        text = sort_reading_order(detections, y_tolerance=12)\n        if device.startswith("cuda"):\n            torch.cuda.synchronize(device)\n        elapsed = time.perf_counter() - start\n        return text, elapsed, len(text.split()), False\n\n# Warm-up all GPU replicas\nfor wid in range(NUM_WORKERS):\n    _wt, _wsec, _, _ = predict_page(pairs[wid]["image_path"], worker_id=wid)\n    print(f"Warm-up worker {wid} ({DEVICES[wid]}) done in {_wsec:.2f}s | sample: {_wt[:120]}")'}, {'cell_type': 'markdown', 'id': 'e4f7a853', 'metadata': {}, 'source': '## 6. Zero-Shot Data-Parallel Inference Loop with Checkpointing'}, {'cell_type': 'code', 'execution_count': 6, 'id': '89252067', 'metadata': {'execution': {'iopub.execute_input': '2026-11-21T18:51:00.992316Z', 'iopub.status.busy': '2026-11-21T18:51:00.991701Z', 'iopub.status.idle': '2026-11-22T01:13:32.386407Z', 'shell.execute_reply': '2026-11-22T01:13:32.385850Z'}, 'trusted': False}, 'outputs': [{'name': 'stdout', 'output_type': 'stream', 'text': 'Pending samples to evaluate: 9,000 across 1 GPU worker(s)\n'}, {'data': {'application/vnd.jupyter.widget-view+json': {'model_id': '7264e204ff504919ba62fefff9ab90f7', 'version_major': 2, 'version_minor': 0}, 'text/plain': 'Evaluating easyocr (1x GPU):   0%|          | 0/9000 [00:00<?, ?it/s]'}, 'metadata': {}, 'output_type': 'display_data'}, {'name': 'stdout', 'output_type': 'stream', 'text': 'Completed: 9,000 / 9,000 OK\n'}, {'data': {'text/html': '\n  <div id="df-7f4f9c61-be73-453f-9042-f6c1bc07409a" class="colab-df-conta