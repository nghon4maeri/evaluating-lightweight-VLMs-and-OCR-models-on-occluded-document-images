loat(ok[m].mean()) for m in metric_cols}\noverall.update({\n    "model_id": MODEL_ID,\n    "num_gpus_used": NUM_WORKERS,\n    "n_success": int(len(ok)),\n    "n_errors": int(len(results) - len(ok)),\n    "n_possibly_truncated": int(ok["possibly_truncated"].sum()),\n    "total_wall_time_sec": float(time.perf_counter() - NOTEBOOK_START_TIME),\n})\n\nby_category = aggregate_metrics(ok, ["category"])\nby_type = aggregate_metrics(ok, ["category", "occlusion_type"])\nby_density = aggregate_metrics(ok, ["category", "occlusion_density"])\n\nprint("OVERALL MACRO-AVERAGED METRICS:")\nprint(json.dumps(overall, indent=2))\ndisplay(by_category)\ndisplay(by_type)\ndisplay(by_density)\n\nby_category.to_csv(OUTPUT_DIR / "summary_by_category.csv", index=False)\nby_type.to_csv(OUTPUT_DIR / "summary_by_occlusion_type.csv", index=False)\nby_density.to_csv(OUTPUT_DIR / "summary_by_density.csv", index=False)\n(OUTPUT_DIR / "run_config.json").write_text(json.dumps(overall, indent=2), encoding="utf-8")'}, {'cell_type': 'markdown', 'id': 'ba07148d', 'metadata': {}, 'source': '## 8. Output Validation & Packaging (`results.zip`)'}, {'cell_type': 'code', 'execution_count': 8, 'id': '2cb3a711', 'metadata': {'execution': {'iopub.execute_input': '2026-11-22T01:13:32.508758Z', 'iopub.status.busy': '2026-11-22T01:13:32.508525Z', 'iopub.status.idle': '2026-11-22T01:13:35.435069Z', 'shell.execute_reply': '2026-11-22T01:13:35.434502Z'}, 'trusted': False}, 'outputs': [{'name': 'stdout', 'output_type': 'stream', 'text': '[OK] per_image_results.csv (63,801,645 bytes)\n[OK] summary_by_category.csv (367 bytes)\n[OK] summary_by_occlusion_type.csv (1,796 bytes)\n[OK] summary_by_density.csv (470,307 bytes)\n[OK] run_config.json (402 bytes)\n'}, {'name': 'stdout', 'output_type': 'stream', 'text': 'Packaged results archive: /content/easyocr_results.zip\n'}], 'source': 'expected_files = [\n    "per_image_results.csv",\n    "summary_by_category.csv",\n    "summary_by_occlusion_type.csv",\n    "summary_by_density.csv",\n    "run_config.json",\n]\nfor fname in expected_files:\n    fpath = OUTPUT_DIR / fname\n    assert fpath.exists() and fpath.stat().st_size > 0, f"Missing or empty output: {fpath}"\n    print(f"[OK] {fname} ({fpath.stat().st_size:,} bytes)")\n\nzip_dest = OUTPUT_DIR.parent / f"{MODEL_SLUG}_results"\nzip_path = shutil.make_archive(str(zip_dest), "zip", root_dir=OUTPUT_DIR)\nprint("Packaged results archive:", zip_path)'}], 'metadata': {'accelerator': 'GPU', 'colab': {'gpuType': 'A100', 'name': '05_eval_easyocr.ipynb', 'provenance': []}, 'gpuClass': 'premium', 'kernelspec': {'display_name': 'Python 3', 'language': 'python', 'name': 'python3'}, 'language_info': {'name': 'python'}}, 'nbformat': 4, 'nbformat_minor': 5}