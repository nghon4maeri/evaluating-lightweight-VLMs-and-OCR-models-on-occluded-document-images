   0p5pct   \n7     text    Through_Dust                                          1p0pct   \n8     text   Through_Stamp  111.tar_1507.04951.gz_comb_model_arxiv_106_ori   \n9  nontext       Black_Ink                                          1p0pct   \n\n        cer       wer  token_f1  latency_sec status  \n0  0.618975  0.740426  0.385321     0.368723     ok  \n1  0.523368  0.731959  0.398217     0.883420     ok  \n2  0.516356  0.664634  0.751540     1.736086     ok  \n3  0.390496  0.780523  0.324034     1.661888     ok  \n4  0.281073  0.674965  0.454023     1.948534     ok  \n5  0.505529  0.646721  0.794791     2.451492     ok  \n6  0.311095  0.660061  0.466000     1.103436     ok  \n7  0.546690  0.748858  0.418239     0.782097     ok  \n8  0.231371  0.575926  0.546099     1.204093     ok  \n9  0.680889  0.729577  0.538318     1.597641     ok  '}, 'execution_count': 6, 'metadata': {}, 'output_type': 'execute_result'}], 'source': 'RESULTS_CSV = OUTPUT_DIR / "per_image_results.csv"\n\nFIELDNAMES = [\n    "category", "sample_id", "occlusion_type", "occlusion_density", "batch_id",\n    "model_id", "status", "error", "prediction", "ground_truth",\n    "latency_sec", "generated_tokens", "possibly_truncated",\n    "cer", "wer", "token_precision", "token_recall", "token_f1",\n    "gt_words", "pred_words",\n]\n\ncompleted = set()\nif RESULTS_CSV.exists():\n    try:\n        prev_df = pd.read_csv(RESULTS_CSV, usecols=["sample_id", "status"])\n        completed = set(prev_df.loc[prev_df["status"] == "ok", "sample_id"].astype(str).tolist())\n        print(f"Resuming from checkpoint: {len(completed):,} samples already completed.")\n    except Exception as e:\n        print("Checkpoint read warning:", e)\n\npending_pairs = [s for s in pairs if s["sample_id"] not in completed]\nprint(f"Pending samples to evaluate: {len(pending_pairs):,} across {NUM_WORKERS} GPU worker(s)")\n\n\ndef evaluate_single_sample(args: tuple[int, dict]) -> dict:\n    idx, sample = args\n    worker_id = idx % NUM_WORKERS\n    stem = sample["sample_id"]\n    row = {\n        "category": sample["category"],\n        "sample_id": stem,\n        "occlusion_type": sample["occlusion_type"],\n        "occlusion_density": sample["occlusion_density"],\n        "batch_id": sample["batch_id"],\n        "model_id": MODEL_ID,\n        "status": "error",\n        "error": "",\n        "prediction": "",\n        "ground_truth": "",\n        "latency_sec": np.nan,\n        "generated_tokens": 0,\n        "possibly_truncated": False,\n        "cer": np.nan,\n        "wer": np.nan,\n        "token_precision": np.nan,\n        "token_recall": np.nan,\n        "token_f1": np.nan,\n        "gt_words": 0,\n        "pred_words": 0,\n    }\n    try:\n        prediction, elapsed_sec, n_tokens, truncated = predict_page(sample["image_path"], worker_id=worker_id)\n        ground_truth = " ".join(read_gt_tokens(sample["gt_path"]))\n        metrics = compute_metrics(ground_truth, prediction)\n        row.update({\n            "status": "ok",\n            "prediction": prediction,\n            "ground_truth": ground_truth,\n            "latency_sec": elapsed_sec,\n            "generated_tokens": n_tokens,\n            "possibly_truncated": truncated,\n            **metrics,\n        })\n    except Exception as exc:\n        row["error"] = repr(exc)\n        print(f"[ERROR] {stem} (worker {worker_id}): {exc!r}")\n    return row\n\n\nwrite_header = not RESULTS_CSV.exists() or RESULTS_CSV.stat().st_size == 0\nwith open(RESULTS_CSV, "a", newline="", encoding="utf-8") as csv_file:\n    writer = csv.DictWriter(csv_file, fieldnames=FIELDNAMES)\n    if write_header:\n        writer.writeheader()\n        csv_file.flush()\n\n    # Process in chunks of 16 so we can check the 11.2h time guard and flush checkpoints cleanly\n    CHUNK_SIZE = 16\n    pbar = tqdm(total=len(pending_pairs), desc=f"Evaluating {MODEL_SLUG} ({NUM_WORKERS}x GPU)")\n    with concurrent.futures.ThreadPoolExecutor(max_workers=NUM_WORKERS) as pool:\n        for start_idx in range(0, len(pending_pairs), CHUNK_SIZE):\n            if (time.perf_counter() - NOTEBOOK_START_TIME) >= MAX_RUNTIME_SECONDS:\n                print(f"[TIME_GUARD] Reached {MAX_RUNTIME_SECONDS/3600:.1f}h session budget. Stopping loop cleanly to save summary & zip.")\n                break\n\n            chunk = [\n                (start_idx + offset, sample)\n                for offset, sample in enumerate(pending_pairs[start_idx : start_idx + CHUNK_SIZE])\n            ]\n            for row in pool.map(evaluate_single_sample, chunk):\n                writer.writerow(row)\n                pbar.update(1)\n            csv_file.flush()\n\n            if ((start_idx // CHUNK_SIZE) + 1) % 10 == 0 and torch.cuda.is_available():\n                torch.cuda.empty_cache()\n    pbar.close()\n\nresults = pd.read_csv(RESULTS_CSV)\nprint(f"Completed: {(results[\'status\'] == \'ok\').sum():,} / {len(results):,} OK")\nresults[["category", "occlusion_type", "occlusion_density", "cer", "wer", "token_f1", "latency_sec", "status"]].head(10)'}, {'cell_type': 'markdown', 'id': '583c995d', 'metadata': {}, 'source': '## 7. Macro-Aggregation (Overall, Category, Occlusion Type & Density)'}, {'cell_type': 'code', 'execution_count': 7, 'id': '9f63bbae', 'metadata': {'execution': {'iopub.execute_input': '2026-11-21T18:38:59.227917Z', 'iopub.status.busy': '2026-11-21T18:38:59.227228Z', 'iopub.status.idle': '2026-11-21T18:38:59.396973Z', 'shell.execute_reply': '2026-11-21T18:38:59.396444Z'}, 'trusted': False}, 'outputs': [{'name': 'stdout', 'output_type': 'stream', 'text': 'OVERALL MACRO-AVERAGED METRICS:\n{\n  "mean_cer": 0.3956174330885532,\n  "mean_wer": 0.6174479696115058,\n  "mean_token_precision": 0.7559694445974375,\n  "mean_token_recall": 0.4502362901035652,\n  "mean_token_f1": 0.5486724400662546,\n  "mean_latency_sec": 1.1440873906649858,\n  "model_id": "PaddleOCR-PP-OCRv4",\n  "num_gpus_used": 1,\n  "n_success": 9000,\n  "n_errors": 0,\n  "n_possibly