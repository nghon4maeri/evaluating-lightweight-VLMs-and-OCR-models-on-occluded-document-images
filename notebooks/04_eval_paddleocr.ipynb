(ok, ["category", "occlusion_type"])\nby_density = aggregate_metrics(ok, ["category", "occlusion_density"])\n\nprint("OVERALL MACRO-AVERAGED METRICS:")\nprint(json.dumps(overall, indent=2))\ndisplay(by_category)\ndisplay(by_type)\ndisplay(by_density)\n\nby_category.to_csv(OUTPUT_DIR / "summary_by_category.csv", index=False)\nby_type.to_csv(OUTPUT_DIR / "summary_by_occlusion_type.csv", index=False)\nby_density.to_csv(OUTPUT_DIR / "summary_by_density.csv", index=False)\n(OUTPUT_DIR / "run_config.json").write_text(json.dumps(overall, indent=2), encoding="utf-8")'}, {'cell_type': 'markdown', 'id': 'b41a87cc', 'metadata': {}, 'source': '## 8. Output Validation & Packaging (`results.zip`)'}, {'cell_type': 'code', 'execution_count': 8, 'id': '13d1eabb', 'metadata': {'execution': {'iopub.execute_input': '2026-11-21T18:38:59.403106Z', 'iopub.status.busy': '2026-11-21T18:38:59.402543Z', 'iopub.status.idle': '2026-11-21T18:39:01.860878Z', 'shell.execute_reply': '2026-11-21T18:39:01.860298Z'}, 'trusted': False}, 'outputs': [{'name': 'stdout', 'output_type': 'stream', 'text': '[OK] per_image_results.csv (64,629,628 bytes)\n[OK] summary_by_category.csv (362 bytes)\n[OK] summary_by_occlusion_type.csv (1,785 bytes)\n[OK] summary_by_density.csv (470,755 bytes)\n[OK] run_config.json (407 bytes)\n'}, {'name': 'stdout', 'output_type': 'stream', 'text': 'Packaged results archive: /content/paddleocr_ppocrv4_results.zip\n'}], 'source': 'expected_files = [\n    "per_image_results.csv",\n    "summary_by_category.csv",\n    "summary_by_occlusion_type.csv",\n    "summary_by_density.csv",\n    "run_config.json",\n]\nfor fname in expected_files:\n    fpath = OUTPUT_DIR / fname\n    assert fpath.exists() and fpath.stat().st_size > 0, f"Missing or empty output: {fpath}"\n    print(f"[OK] {fname} ({fpath.stat().st_size:,} bytes)")\n\nzip_dest = OUTPUT_DIR.parent / f"{MODEL_SLUG}_results"\nzip_path = shutil.make_archive(str(zip_dest), "zip", root_dir=OUTPUT_DIR)\nprint("Packaged results archive:", zip_path)'}], 'metadata': {'accelerator': 'GPU', 'colab': {'gpuType': 'A100', 'name': '04_eval_paddleocr.ipynb', 'provenance': []}, 'gpuClass': 'premium', 'kernelspec': {'display_name': 'Python 3', 'language': 'python', 'name': 'python3'}, 'language_info': {'name': 'python'}}, 'nbformat': 4, 'nbformat_minor': 5}